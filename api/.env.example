# Copy this file to .env and fill in real values:
#   copy .env.example .env
# Never commit .env. Ask Humera for Cosmos keys. Ask Mo for the Firebase Admin JSON.

# --- Express ---
PORT=3000
NODE_ENV=development

# Phone emulator talking to your PC: 10.0.2.2
# Physical phone: your PC's LAN IP, e.g. http://192.168.1.10:3000
API_PUBLIC_URL=http://10.0.2.2:3000

# Local demo without Firebase tokens (never use in production / POE demo on a marked device)
SKIP_AUTH=true
DEV_USER_ID=dev-user
DEV_USER_EMAIL=dev@sportsphere.app
DEV_USER_NAME=Dev User

# --- Azure Cosmos DB (account: prog7314, database: sportsphere) ---
# Portal → prog7314 → Keys → URI + PRIMARY KEY
# Containers: users (/userId), sports (/sportId), events (/sportId),
#             performance (/userId), learning (/sportId)
COSMOS_ENDPOINT=https://prog7314.documents.azure.com:443/
COSMOS_KEY=paste-primary-key-here
COSMOS_DATABASE=sportsphere

# Use this instead of ENDPOINT + KEY if you prefer one string
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://prog7314.documents.azure.com:443/;AccountKey=paste-key-here;

# --- Firebase Admin (API checks Google / email ID tokens) ---
# Mo: Firebase console → Project settings → Service accounts → Generate new private key
# Save the JSON next to this file as firebase-service-account.json (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id
