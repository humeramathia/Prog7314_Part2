# Copy to keystore.properties (ignored). Do not commit the real values.
# Use forward slashes in Windows paths, e.g. C:/Users/yourname/keys/sportsphere-upload.jks
storeFile=/absolute/path/outside/repository/sportsphere-upload.jks
storePassword=YOUR_PRIVATE_STORE_PASSWORD
keyAlias=sportsphere-upload
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
